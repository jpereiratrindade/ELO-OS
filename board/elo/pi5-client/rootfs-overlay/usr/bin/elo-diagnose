#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Do not print passwords, PSKs, bearer tokens or complete configuration files.
printf '\n=== ELO: horário UTC ===\n'
date -u
printf '\n=== Sincronização de horário ===\n'
chronyc tracking 2>&1
chronyc sources 2>&1
printf '\n=== IPv4 e rotas ===\n'
ip -4 addr show
ip route
printf '\n=== Wi-Fi ===\n'
wpa_cli -i wlan0 status 2>&1
printf '\n=== SSH e apresentação ===\n'
for name in dropbear.pid elo-client/supervisor.pid elo-client/child.pid; do
  if [ -s "/run/$name" ]; then
    pid=$(cat "/run/$name")
    if kill -0 "$pid" 2>/dev/null; then printf '%s: ativo PID %s\n' "$name" "$pid"; else printf '%s: parado\n' "$name"; fi
  else printf '%s: sem PID\n' "$name"; fi
done
[ ! -r /run/elo-client/health ] || cat /run/elo-client/health
printf '\n=== Teste HTTPS do servidor ===\n'
if [ -s /etc/elo-terminal/server.url ]; then
  if [ -f /etc/elo-terminal/ca.pem ]; then
    elo-network-probe --server "$(cat /etc/elo-terminal/server.url)" --token-file /etc/elo-terminal/terminal.token --ca-file /etc/elo-terminal/ca.pem
  else
    elo-network-probe --server "$(cat /etc/elo-terminal/server.url)" --token-file /etc/elo-terminal/terminal.token
  fi
else echo 'Servidor não provisionado'; fi
printf '\n=== Últimas mensagens do cliente ===\n'
tail -n 30 /run/elo-client/client.log 2>/dev/null
exit 0
