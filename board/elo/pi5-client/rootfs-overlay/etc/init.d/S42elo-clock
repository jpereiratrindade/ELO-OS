#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# A trusted provisioning-time floor helps bootstrap TLS before NTP is available.
set -eu
state=/var/lib/elo-time
file=$state/last-good-utc
case "${1:-}" in
  start)
    [ -r "$file" ] || exit 0
    floor=$(cat "$file")
    case "$floor" in ''|*[!0-9]*) exit 1 ;; esac
    [ "${#floor}" -le 10 ] || exit 1
    now=$(date -u +%s)
    if [ "$floor" -gt "$now" ]; then date -u -s "@$floor"; fi
    ;;
  stop)
    now=$(date -u +%s)
    [ "$now" -ge 1704067200 ] || exit 0
    if [ -r "$file" ]; then
      previous=$(cat "$file")
      case "$previous" in ''|*[!0-9]*) ;; *)
        if [ "${#previous}" -le 10 ] && [ "$previous" -gt "$now" ]; then exit 0; fi ;;
      esac
    fi
    mkdir -p "$state"
    chmod 700 "$state"
    umask 077
    printf '%s\n' "$now" > "$state/.clock"
    mv "$state/.clock" "$file"
    sync
    ;;
  restart) "$0" stop && "$0" start ;;
  *) exit 2 ;;
esac
