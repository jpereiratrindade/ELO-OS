config BR2_PACKAGE_ELO_CLIENT
    bool "elo-client (Qt Quick proof-of-concept; P2)"
    depends on BR2_PACKAGE_QT6BASE_GUI
    depends on BR2_PACKAGE_QT6DECLARATIVE
    help
      Aplicação Qt/QML mínima para teste gráfico.
      Não implementa o protocolo nem o domínio ELO.
      Exige configuração apropriada da pilha gráfica DRM/KMS.
