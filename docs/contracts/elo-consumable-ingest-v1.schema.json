{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "elo-consumable-ingest/v1 — initial PCM WAV profile",
  "$comment": "Narrow initial profile. Runtime also enforces UTF-8 byte limits, non-whitespace text, file integrity and PCM structure. Rights are declarations, not approval.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "elo-consumable-ingest/v1"
    },
    "production_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "production_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "system": {
          "const": "sister-studio"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f]+$"
        }
      },
      "required": [
        "system",
        "release"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "suggested_uses": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\u0000-\\u001f]+$"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "role": {
            "const": "primary"
          },
          "kind": {
            "const": "media.audio"
          },
          "filename": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,123}\\.wav$"
          },
          "mime": {
            "const": "audio/wav"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          }
        },
        "required": [
          "asset_id",
          "role",
          "kind",
          "filename",
          "mime",
          "size_bytes",
          "sha256",
          "duration_ms"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "declared_creator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "source_project_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "reviewed": {
          "const": true
        }
      },
      "required": [
        "declared_creator",
        "source_project_ref",
        "reviewed"
      ],
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "rights_holder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "voice_permission": {
          "enum": [
            "not-applicable",
            "granted"
          ]
        }
      },
      "required": [
        "license",
        "rights_holder",
        "voice_permission"
      ],
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "classification": {
          "const": "public"
        },
        "purpose": {
          "const": "catalogo-editorial-e-distribuicao"
        }
      },
      "required": [
        "classification",
        "purpose"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "production_id",
    "production_version",
    "producer",
    "title",
    "description",
    "language",
    "suggested_uses",
    "assets",
    "provenance",
    "rights",
    "privacy"
  ],
  "additionalProperties": false
}
