# Virtual development target based on Buildroot 2026.08.1 qemu_x86_64_defconfig.
# Uses the host QEMU; keep this build separate from the Raspberry Pi image.
BR2_x86_64=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_GLIBC_STABLE=y
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_HOSTNAME="elo-os"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ELO_OS_PATH)/board/elo/common/rootfs-overlay $(BR2_EXTERNAL_ELO_OS_PATH)/board/elo/qemu-x86_64-appliance/rootfs-overlay $(BR2_EXTERNAL_ELO_OS_PATH)/board/elo/qemu-gui/rootfs-overlay $(BR2_EXTERNAL_ELO_OS_PATH)/board/elo/appliance/rootfs-overlay"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/x86_64/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set

# P2 experimental: CPU-rendered Qt Quick, LinuxFB/DRM dumb buffers, no desktop.
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_LINUXFB=y
BR2_PACKAGE_QT6BASE_DEFAULT_QPA="linuxfb"
BR2_PACKAGE_QT6DECLARATIVE=y
BR2_PACKAGE_QT6DECLARATIVE_QUICK=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_DEJAVU=y
# BR2_PACKAGE_DEJAVU_MONO is not set
# BR2_PACKAGE_DEJAVU_SERIF is not set
# BR2_PACKAGE_DEJAVU_SANS_CONDENSED is not set
# BR2_PACKAGE_DEJAVU_SERIF_CONDENSED is not set
BR2_PACKAGE_ELO_CLIENT=y

# Virtual appliance storage; physical Pi 5 and P2 GUI profiles stay unchanged.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ELO_OS_PATH)/board/elo/appliance/busybox.fragment"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ELO_OS_PATH)/board/elo/appliance/post-build.sh"
